# Copy to Vercel project Environment Variables (never commit real values).
# Paystack: Settings -> API Keys & Webhooks (SECRET, test or live).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Upstash Redis: https://console.upstash.com -> REST API (.env section).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Resend: https://resend.com/api-keys (free: 100/day, 3000/month).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender in Resend (domain or onboarding address).
MAIL_FROM="QueryPic Pro <pro@querypic.example.com>"
# Shown in the license email.
APP_NAME=QueryPic
